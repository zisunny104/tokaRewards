<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion><groupId>dev.toka</groupId><artifactId>tokaRewards</artifactId><version>0.3.8</version>
  <properties><maven.compiler.release>21</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <repositories><repository><id>plan-releases</id><url>https://repo.playeranalytics.net/releases</url></repository></repositories>
  <dependencies>
    <dependency><groupId>com.djrapitops</groupId><artifactId>plan-api</artifactId><version>5.7-R0.2</version><scope>provided</scope></dependency>
    <dependency><groupId>cn.nukkit</groupId><artifactId>Nukkit</artifactId><version>1.0-SNAPSHOT</version><scope>provided</scope></dependency>
    <dependency><groupId>dev.toka</groupId><artifactId>tokaStorage</artifactId><version>0.1.4</version></dependency>
    <dependency><groupId>dev.toka</groupId><artifactId>tokaI18n</artifactId><version>0.2.3</version></dependency>
    <dependency><groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.2.5</version></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version><configuration><proc>none</proc></configuration></plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.5.1</version>
      <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
        <createDependencyReducedPom>false</createDependencyReducedPom>
        <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/></transformers>
        <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/*.DSA</exclude></excludes></filter></filters>
        <relocations><relocation><pattern>dev.toka.storage</pattern><shadedPattern>dev.toka.rewards.internal.storage</shadedPattern></relocation><relocation><pattern>dev.toka.i18n</pattern><shadedPattern>dev.toka.rewards.internal.i18n</shadedPattern></relocation><relocation><pattern>org.yaml.snakeyaml</pattern><shadedPattern>dev.toka.rewards.internal.yaml</shadedPattern></relocation></relocations>
      </configuration></execution></executions>
    </plugin>
  </plugins></build>
</project>

